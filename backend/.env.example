# Runtime
APP_ENV=development
APP_DATA_DIR=.
JWT_SECRET=replace-with-a-long-random-value
JWT_ISSUER=study-os-api
JWT_AUDIENCE=study-os-web
BCRYPT_ROUNDS=12
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Authentication abuse protection. Separate account and client buckets are
# stored only as keyed digests; no raw email or client address is persisted.
LOGIN_MAX_ATTEMPTS=5
LOGIN_CLIENT_MAX_ATTEMPTS=25
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Account verification. Use console locally; use smtp in production.
EMAIL_DELIVERY_MODE=console
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Study OS
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Google Identity Services web OAuth client ID.
GOOGLE_CLIENT_ID=

# Stripe Billing. Price IDs must refer to recurring prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT_PRO=
STRIPE_PRICE_PROFESSIONAL=

# SQLite defaults to APP_DATA_DIR/study_assistant.db. Override this when using
# PostgreSQL or another database.
# DATABASE_URL=sqlite:///./study_assistant.db

# Optional storage overrides. Normally APP_DATA_DIR is enough.
# UPLOAD_DIR=./uploads
# LOCAL_TRANSCRIPTION_CACHE_DIR=./whisper-models
MAX_PDF_UPLOAD_MB=50
MAX_AUDIO_CHUNK_MB=25

# Optional usage-limit overrides. Leave these unset to use the built-in
# free/student/professional defaults.
# LIMIT_PDFS_TOTAL_STUDENT=3
# LIMIT_AI_MESSAGES_DAILY_STUDENT=30
# LIMIT_NOTE_GENERATIONS_DAILY_STUDENT=10
# LIMIT_CONTENT_GENERATIONS_DAILY_STUDENT=150
# LIMIT_PRACTICE_GENERATIONS_DAILY_STUDENT=150
# LIMIT_TRANSCRIPT_MINUTES_DAILY_STUDENT=30
# LIMIT_PDFS_TOTAL_STUDENT_PRO=50
# LIMIT_AI_MESSAGES_DAILY_STUDENT_PRO=300
# LIMIT_NOTE_GENERATIONS_DAILY_STUDENT_PRO=100
# LIMIT_CONTENT_GENERATIONS_DAILY_STUDENT_PRO=300
# LIMIT_PRACTICE_GENERATIONS_DAILY_STUDENT_PRO=200
# LIMIT_TRANSCRIPT_MINUTES_DAILY_STUDENT_PRO=300
# LIMIT_PDFS_TOTAL_PROFESSIONAL=100
# LIMIT_AI_MESSAGES_DAILY_PROFESSIONAL=500
# LIMIT_NOTE_GENERATIONS_DAILY_PROFESSIONAL=150
# LIMIT_CONTENT_GENERATIONS_DAILY_PROFESSIONAL=300
# LIMIT_TRANSCRIPT_MINUTES_DAILY_PROFESSIONAL=300

# Language models
LLM_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
OUTLINE_LLM_ENABLED=false
# Consolidate PDFs with more than eight detected content topics. This may make
# one bounded LLM request even while OUTLINE_LLM_ENABLED is false.
SUBTOPIC_CONSOLIDATION_ENABLED=false
# Used only for optional outline/path AI calls, including the one-call
# consolidation guard when a PDF produces more than eight content subtopics.
OUTLINE_TIMEOUT_SECONDS=90

# Chroma Cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Local Whisper. In a hosted deployment this runs on the backend server.
LECTURE_TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_MODEL=small
LOCAL_TRANSCRIPTION_DEVICE=cpu
LOCAL_TRANSCRIPTION_COMPUTE_TYPE=int8
