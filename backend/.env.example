# Runtime
APP_ENV=development
APP_DATA_DIR=.
JWT_SECRET=replace-with-a-long-random-value
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Account verification. Use console locally; use smtp in production.
EMAIL_DELIVERY_MODE=console
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Study OS
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Google Identity Services web OAuth client ID.
GOOGLE_CLIENT_ID=

# SQLite defaults to APP_DATA_DIR/study_assistant.db. Override this when using
# PostgreSQL or another database.
# DATABASE_URL=sqlite:///./study_assistant.db

# Optional storage overrides. Normally APP_DATA_DIR is enough.
# UPLOAD_DIR=./uploads
# LOCAL_TRANSCRIPTION_CACHE_DIR=./whisper-models

# Language models
LLM_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
OUTLINE_LLM_ENABLED=false

# Chroma Cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Local Whisper. In a hosted deployment this runs on the backend server.
LECTURE_TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_MODEL=small
LOCAL_TRANSCRIPTION_DEVICE=cpu
LOCAL_TRANSCRIPTION_COMPUTE_TYPE=int8
