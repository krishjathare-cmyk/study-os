APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=study-os-api
JWT_AUDIENCE=study-os-web
BCRYPT_ROUNDS=12

EMAIL_DELIVERY_MODE=smtp
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Study OS
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# docker-compose.prod.yml supplies these values. For docker-compose.aws.yml,
# set the RDS URL and Google client ID here instead.
DATABASE_URL=postgresql+psycopg://study_os:password@rds-endpoint:5432/study_os
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
FRONTEND_URL=https://study.example.com
FRONTEND_ORIGINS=https://study.example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT_PRO=
STRIPE_PRICE_PROFESSIONAL=

LLM_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
OUTLINE_LLM_ENABLED=false
SUBTOPIC_CONSOLIDATION_ENABLED=false
OUTLINE_TIMEOUT_SECONDS=90

CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

MAX_PDF_UPLOAD_MB=50
MAX_AUDIO_CHUNK_MB=25
LECTURE_TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_MODEL=small
LOCAL_TRANSCRIPTION_DEVICE=cpu
LOCAL_TRANSCRIPTION_COMPUTE_TYPE=int8
